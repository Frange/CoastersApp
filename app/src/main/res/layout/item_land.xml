<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/item_ride_padding"
    android:paddingTop="@dimen/item_ride_padding"
    android:paddingEnd="@dimen/item_ride_padding"
    android:paddingBottom="@dimen/item_ride_padding">

    <TextView
        android:id="@+id/land_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:background="@color/always_white"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@+id/land_name" />

</androidx.constraintlayout.widget.ConstraintLayout>