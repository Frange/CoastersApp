<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_widget_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/ll_widget_name_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="6"
        android:background="@color/widget_row_background"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_widget_ride_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/always_white"
            android:textSize="14sp"
            tools:text="Stunt fall" />

        <TextView
            android:id="@+id/tv_widget_last_updated"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:textColor="@color/primary_text"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="10:20"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_widget_time_item"
        android:layout_width="68dp"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="8dp"
        android:background="@color/always_black"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_widget_ride_time"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="1"
            android:textColor="@color/always_black"
            android:textSize="14sp"
            tools:text="5 mins" />

    </LinearLayout>

</LinearLayout>